{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postiz-business-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "BUSINESSES", "class_name": "BusinessWorkspace" },
      { "name": "DIRECTORY", "class_name": "BusinessDirectory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusinessWorkspace", "BusinessDirectory"] }],
  "vars": {
    "FANVUE_API_VERSION": "2025-06-26",
    "PUBLIC_ORIGIN": "https://postiz-business-hub.robertwood50.workers.dev"
  },
  "observability": { "enabled": true }
}

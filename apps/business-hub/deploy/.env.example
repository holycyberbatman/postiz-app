# Set an explicit release tag or digest from ghcr.io/gitroomhq/postiz-app.
POSTIZ_IMAGE=
POSTIZ_PUBLIC_ORIGIN=https://postiz.example.com
# Use unique random alphanumeric values; preserve these across restarts/upgrades.
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# Temporarily false ONLY during restricted first-owner bootstrap.
DISABLE_REGISTRATION=true
API_LIMIT=30
# Add only the OAuth credentials needed by your social platforms.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
